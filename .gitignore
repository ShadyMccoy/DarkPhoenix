# yarn lock file
/yarn.lock

# npm lock file (v5.0.0+)
**/package-lock.json

# Ignore basic folders
/dist
/.rpt2_cache
/tsc-out
**/node_modules
/_book
/build/*

# TypeScript definitions installed by Typings
/typings

# Screeps Config
screeps.json
.screeps.json
Gruntfile.js

# Environment variables (contains API keys)
.env

# Telemetry app config (contains tokens)
telemetry-app/config.json
telemetry-app/telemetry-cache.json

# ScreepsServer data from integration tests
/server

# Numerous always-ignore extensions
*.diff
*.err
*.orig
*.log
*.rej
*.swo
*.swp
*.zip
*.vi
*~

# Editor folders
.cache
.project
.settings
.tmproj
*.esproj
nbproject
*.sublime-project
*.sublime-workspace
.idea

# =========================
# Operating System Files
# =========================

# OSX
# =========================

.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear on external disk
.Spotlight-V100
.Trashes

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
# =========================

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Generated scenario snapshots (regenerate via scripts/scenario-roundtrip.ts)
test/fixtures/snapshots/

# Grid run artifact (the committed ratchet is test/grid/baseline.json)
test/grid/last-run.json
# grid:full per-world verdicts, merged then discarded (scripts/grid-full.sh)
test/grid/.batch-verdicts/

# ---------------------------------------------------------------------------
# TELEMETRY CAPTURES ARE SCRATCH BY DEFAULT (owner 2026-08-06: "I don't wanna
# check in because it's just gonna explode the size of the repo").
#
# Every audit cycle writes one, and they had been committed by habit: 342 files
# / 38MB, of which exactly 19 were referenced by any test. A capture is 60K
# median and up to 512K, so a few cycles a day compounds fast.
#
# Already-tracked fixtures are UNAFFECTED - git only ignores untracked files -
# so the pinned set a test names stays pinned. To add a genuinely new one,
# `git add -f` it, which is the right amount of friction: it should be a
# deliberate act tied to a test that reads it, not a side effect of running
# the audit.
# ---------------------------------------------------------------------------
test/fixtures/telemetry/*.json
